{
  "apiVersion": "fig/v1alpha1",
  "scope": "demo",
  "generation": "1",
  "resources": [
    {
      "type": "fig.match/v1alpha1",
      "name": "select-waf",
      "version": "1",
      "spec": {
        "phase": "request-headers",
        "outputType": "fig.waf-policy-ref/v1alpha1",
        "facts": [
          {
            "name": "path",
            "extractor": "input-field/v1",
            "type": "string",
            "args": {
              "name": "path"
            }
          }
        ],
        "rules": [
          {
            "id": "chat",
            "when": {
              "op": "equals",
              "fact": "path",
              "values": [
                {
                  "kind": "string",
                  "text": "/chat"
                }
              ]
            },
            "result": {
              "policyRef": {
                "type": "fig.waf-policy/v1alpha1",
                "name": "chat-policy",
                "version": "1"
              }
            }
          },
          {
            "id": "observe",
            "when": {
              "op": "equals",
              "fact": "path",
              "values": [
                {
                  "kind": "string",
                  "text": "/observe"
                }
              ]
            },
            "result": {
              "policyRef": {
                "type": "fig.waf-policy/v1alpha1",
                "name": "observe-policy",
                "version": "1"
              }
            }
          }
        ],
        "onNoMatch": {
          "result": {
            "policyRef": {
              "type": "fig.waf-policy/v1alpha1",
              "name": "baseline",
              "version": "1"
            }
          }
        }
      }
    },
    {
      "type": "fig.waf-policy/v1alpha1",
      "name": "baseline",
      "version": "1",
      "spec": {
        "engine": "coraza",
        "mode": "enforce",
        "inspection": "request-headers",
        "rules": {
          "format": "header-rules/v1",
          "items": [
            {
              "id": 1001,
              "header": "X-Fig-Attack",
              "equals": "attack"
            }
          ]
        }
      }
    },
    {
      "type": "fig.waf-policy/v1alpha1",
      "name": "chat-policy",
      "version": "1",
      "spec": {
        "engine": "coraza",
        "mode": "enforce",
        "inspection": "request-headers",
        "rules": {
          "format": "header-rules/v1",
          "items": [
            {
              "id": 1001,
              "header": "X-Fig-Attack",
              "equals": "attack"
            }
          ]
        }
      }
    },
    {
      "type": "fig.waf-policy/v1alpha1",
      "name": "observe-policy",
      "version": "1",
      "spec": {
        "engine": "coraza",
        "mode": "detect",
        "inspection": "request-headers",
        "rules": {
          "format": "header-rules/v1",
          "items": [
            {
              "id": 1001,
              "header": "X-Fig-Attack",
              "equals": "attack"
            }
          ]
        }
      }
    },
    {
      "type": "fig.pipeline/v1alpha1",
      "name": "edge",
      "version": "1",
      "spec": {
        "placement": "downstream-http",
        "steps": [
          {
            "id": "select-policy",
            "module": "fig.match/v1alpha1",
            "configRef": {
              "type": "fig.match/v1alpha1",
              "name": "select-waf",
              "version": "1"
            },
            "onNoMatch": {
              "localReply": {
                "status": 503
              }
            },
            "onError": {
              "localReply": {
                "status": 400
              }
            }
          },
          {
            "id": "inspect",
